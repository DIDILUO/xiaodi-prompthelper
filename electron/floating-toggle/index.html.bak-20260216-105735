<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta
    http-equiv="Content-Security-Policy"
    content="default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'"
  />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <link rel="stylesheet" href="./floating-toggle.css" />
</head>
<body>
  <div id="root">
    <div id="drag-strip" aria-label="drag-window"></div>
    <button id="toggle" type="button" aria-label="toggle-main-window">
      <svg class="icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <rect x="2.5" y="4.5" width="19" height="15" rx="1.6" stroke="currentColor" stroke-width="1.5" />
        <path d="M6.5 9.5L10 12L6.5 14.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        <path d="M12.5 15.5H18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
      </svg>
    </button>
  </div>
  <script src="./floating-toggle.js"></script>
</body>
</html>

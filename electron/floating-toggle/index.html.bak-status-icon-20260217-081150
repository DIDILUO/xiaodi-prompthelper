<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta
    http-equiv="Content-Security-Policy"
    content="default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'"
  />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <link rel="stylesheet" href="./floating-toggle.css" />
</head>
<body>
  <div id="root">
    <div id="drag-strip" aria-label="drag-window"></div>
    <button id="toggle" type="button" aria-label="toggle-main-window">
      <img class="icon icon-image" src="./icons/toggle-main.svg" alt="toggle-main-window" />
    </button>
    <div id="quick-divider" aria-hidden="true"></div>
    <div id="quick-group" role="toolbar" aria-label="quick-panels">
      <div class="quick-main-group" role="group" aria-label="quick-main-tools">
        <button class="quick-btn" data-action="identity" type="button" aria-label="quick-identity">
          <img class="quick-icon quick-icon-image" src="./icons/identity.svg" alt="quick-identity" />
        </button>
        <button class="quick-btn" data-action="chat-preset" type="button" aria-label="quick-chat-preset">
          <img class="quick-icon quick-icon-image" src="./icons/chat-preset.svg" alt="quick-chat-preset" />
        </button>
        <button class="quick-btn" data-action="image-preset" type="button" aria-label="quick-image-preset">
          <img class="quick-icon quick-icon-image" src="./icons/image-preset.svg" alt="quick-image-preset" />
        </button>
        <button class="quick-btn" data-action="history" type="button" aria-label="quick-history">
          <img class="quick-icon quick-icon-image" src="./icons/history.svg" alt="quick-history" />
        </button>
      </div>
      <div class="quick-dev-divider" aria-hidden="true"></div>
      <div class="quick-dev-group" role="group" aria-label="quick-dev-tools">
        <button class="quick-btn quick-btn-return-test" data-action="return-test" type="button" aria-label="quick-return-test" title="回传测试">
          <img class="quick-icon quick-icon-image" src="./icons/return-test.svg" alt="quick-return-test" />
        </button>
        <button class="quick-btn quick-btn-restart" data-action="global-restart" type="button" aria-label="quick-global-restart" title="全局重启">
          <img class="quick-icon quick-icon-image" src="./icons/global-restart.svg" alt="quick-global-restart" />
        </button>
      </div>
    </div>
  </div>
  <script src="./floating-toggle.js"></script>
</body>
</html>

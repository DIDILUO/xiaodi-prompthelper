                                                            2
                                                        ],
                                              "theme":  [
                                                            "darkest",
                                                            "dark",
                                                            "medium"
                                                        ]
                                          },
                                          {
                                              "width":  23,
                                              "height":  23,
                                              "path":  "icons/xiaodi_L.png",
                                              "scale":  [
                                                            1,
                                                            2

                                              "theme":  [
                                                            "lightest",
                                                            "light"
                                                        ]
                                          }
                                      ]
                        }
                    ],
    "icons":  [
                  {
                      "width":  23,
                      "height":  23,
                      "path":  "icons/xiaodi_D.png",
                      "scale":  [
                                    1,
                                    2
                                ],
                      "theme":  [
                                    "darkest",
                                    "dark",
                                    "medium"
                                ],
                      "species":  [
                                      "pluginList"
                                  ]
                  },
                  {
                      "width":  48,

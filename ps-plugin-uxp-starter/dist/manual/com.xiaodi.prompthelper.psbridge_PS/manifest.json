{
    "id":  "com.xiaodi.prompthelper.psbridge",
    "name":  "小迪助手 - PS 桥接插件",
    "version":  "0.1.1",
    "main":  "index.html",
    "manifestVersion":  5,
    "host":  {
                 "app":  "PS",
                 "minVersion":  "24.0.0"
             },
    "requiredPermissions":  {
                                "network":  {
                                                "domains":  [
                                                                "http://127.0.0.1:17325",
                                                                "http://127.0.0.1",
                                                                "http://localhost:17325",
                                                                "http://localhost"
                                                            ]
                                            },
                                "localFileSystem":  "fullAccess"
                            },
    "entrypoints":  [
                        {
                            "type":  "panel",
                            "id":  "mainPanel",
                            "label":  "小迪桥接",

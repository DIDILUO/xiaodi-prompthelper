<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta
    http-equiv="Content-Security-Policy"
    content="default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'"
  />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <link rel="stylesheet" href="./floating-toggle.css" />
</head>
<body>
  <div id="root">
    <div id="drag-strip" aria-label="drag-window"></div>
    <button id="toggle" type="button" aria-label="toggle-main-window">
      <svg class="icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <rect x="2.5" y="4.5" width="19" height="15" rx="1.6" stroke="currentColor" stroke-width="1.5" />
        <path d="M6.5 9.5L10 12L6.5 14.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        <path d="M12.5 15.5H18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
      </svg>
    </button>
    <div id="quick-divider" aria-hidden="true"></div>
    <div id="quick-group" role="toolbar" aria-label="quick-panels">
      <button class="quick-btn" data-action="identity" type="button" aria-label="quick-identity">
        <svg class="quick-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <circle cx="12" cy="9" r="3.2" stroke="currentColor" stroke-width="1.5" />
          <path d="M6.5 18.3C7.7 15.7 9.6 14.5 12 14.5C14.4 14.5 16.3 15.7 17.5 18.3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
        </svg>
      </button>
      <button class="quick-btn" data-action="chat-preset" type="button" aria-label="quick-chat-preset">
        <svg class="quick-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M6 4.8H18V19.2L12 16.2L6 19.2V4.8Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
        </svg>
      </button>
      <button class="quick-btn" data-action="image-preset" type="button" aria-label="quick-image-preset">
        <svg class="quick-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <rect x="4" y="6" width="13" height="10" rx="1.8" stroke="currentColor" stroke-width="1.5" />
          <path d="M19 9V18H7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
        </svg>
      </button>
      <button class="quick-btn" data-action="history" type="button" aria-label="quick-history">
        <img class="quick-icon quick-icon-image" src="./chat-history.svg" alt="quick-history" />
      </button>
      <button class="quick-btn" data-action="return-test" type="button" aria-label="quick-return-test" title="回传测试">
        <svg class="quick-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <rect x="4.2" y="4.5" width="15.6" height="15" rx="2" stroke="currentColor" stroke-width="1.5" />
          <path d="M8 12H16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
          <path d="M12 8L16 12L12 16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
      <button class="quick-btn" data-action="global-restart" type="button" aria-label="quick-global-restart" title="全局重启">
        <svg class="quick-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M19 12A7 7 0 1 1 16.8 6.9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
          <path d="M19 4V9H14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
    </div>
  </div>
  <script src="./floating-toggle.js"></script>
</body>
</html>

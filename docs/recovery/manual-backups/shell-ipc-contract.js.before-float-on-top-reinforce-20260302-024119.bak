const SHELL_CHANNELS = Object.freeze(
  Object.entries(SHELL_IPC_CONTRACTS).reduce((acc, [key, contract]) => {
    acc[key] = contract.channel;
    return acc;
  }, {}),
);

const SHELL_EVENT_CHANNELS = Object.freeze({
  resizing: "shell:resizing",
  floatingToggleState: "shell:floating-toggle-state",
  floatingQuickAction: "shell:floating-quick-action",
  globalUploadShortcutAction: "shell:global-upload-shortcut-action",
});

function normalizeShellPayloadObject(value) {
  return value && typeof value === "object" ? value : {};
}

function buildShellResponseEnvelope(payload = {}) {
  const normalizedOk = payload.ok !== false;
  const normalizedData = normalizeShellPayloadObject(payload.data);
  const normalizedLegacy = normalizeShellPayloadObject(payload.legacy);
  const normalizedCode = String(
    payload.code || (normalizedOk ? "ok" : "error"),
  ).trim();
  const normalizedMessage = String(payload.message || "").trim();
  return {
    ok: normalizedOk,
    code: normalizedCode || (normalizedOk ? "ok" : "error"),
    message: normalizedMessage,
    data: normalizedData,
    ...normalizedLegacy,
  };
}

function buildShellOkResponse(
  data = {},
  legacy = {},
  code = "ok",
  message = "",
) {
  return buildShellResponseEnvelope({
    ok: true,
    code,
    message,
    data,
    legacy,
  });
}

function buildShellErrorResponse(
  code = "error",
  message = "",
  data = {},
  legacy = {},
) {
  return buildShellResponseEnvelope({
    ok: false,
    code,
    message,
    data,
    legacy,
  });
}

module.exports = {
  SHELL_IPC_CONTRACTS,
  SHELL_CHANNELS,
  SHELL_EVENT_CHANNELS,
  buildShellResponseEnvelope,
  buildShellOkResponse,
  buildShellErrorResponse,
};

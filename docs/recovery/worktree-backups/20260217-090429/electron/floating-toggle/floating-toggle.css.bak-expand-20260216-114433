:root {
  --drag-strip-height: 20px;
  --toggle-height: 48px;
  --quick-button-size: 32px;
  --quick-button-gap: 6px;
  --quick-padding-y: 6px;
  --divider-height: 1px;
}

html,
body {
  margin: 0;
  width: 100%;
  height: 100%;
  background: transparent;
  overflow: hidden;
  user-select: none;
}

body {
  font-family: "Microsoft YaHei", sans-serif;
  display: block;
}

#root {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  justify-content: flex-start;
  gap: 0;
  background: #323232;
  border-radius: 12px;
  overflow: hidden;
  box-shadow: none;
}

#drag-strip {
  width: 100%;
  height: var(--drag-strip-height);
  display: flex;
  align-items: center;
  justify-content: center;
  -webkit-app-region: drag;
  cursor: move;
  background: transparent;
}

#drag-strip::before {
  content: "";
  width: 14px;
  height: 2px;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.28);
}

#toggle {
  width: calc(100% - 8px);
  height: var(--toggle-height);
  border: none;
  border-radius: 10px;
  margin: 4px;
  background: #262626;
  box-shadow: none;
  color: #ffffff;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  cursor: pointer;
  outline: none;
  transition:
    transform 0.14s ease,
    filter 0.14s ease,
    opacity 0.14s ease,
    background-color 0.14s ease;
  -webkit-app-region: no-drag;
}

#toggle:hover {
  filter: none;
  background: rgba(255, 255, 255, 0.06);
}

#toggle:active {
  transform: scale(0.96);
  background: rgba(255, 255, 255, 0.11);
}

.icon {
  width: 28px;
  height: 28px;
  display: block;
}

#quick-divider {
  width: calc(100% - 8px);
  height: var(--divider-height);
  margin: 0 4px;
  background: rgba(255, 255, 255, 0.12);
  flex: 0 0 auto;
}

#quick-divider.is-hidden {
  display: none;
}

#quick-group {
  width: 100%;
  padding: var(--quick-padding-y) 4px 4px;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: var(--quick-button-gap);
  box-sizing: border-box;
}

#quick-group.is-hidden {
  display: none;
}

.quick-btn {
  width: 100%;
  height: var(--quick-button-size);
  border: none;
  border-radius: 8px;
  background: #262626;
  color: #ffffff;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  -webkit-app-region: no-drag;
  transition: background-color 0.12s ease, filter 0.12s ease, transform 0.12s ease;
}

.quick-btn:hover {
  background: rgba(255, 255, 255, 0.07);
}

.quick-btn:active {
  transform: scale(0.97);
  background: rgba(255, 255, 255, 0.12);
}

.quick-btn.is-active {
  background: rgba(61, 119, 255, 0.2);
}

.quick-icon {
  width: 20px;
  height: 20px;
  display: block;
}

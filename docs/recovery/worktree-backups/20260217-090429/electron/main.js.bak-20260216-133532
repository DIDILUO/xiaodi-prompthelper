        savedItems.push({
          clientRef: String(item?.clientRef || ''),
          fileName,
          filePath,
          byteLength: resolved.buffer.length,
          targetMetaFileName,
          targetMetaFilePath
        });
      }
      pruneGeneratedCacheDir(maxFiles);
      pruneGeneratedTargetMetaDir();
      return {
        ok: true,
        dir,

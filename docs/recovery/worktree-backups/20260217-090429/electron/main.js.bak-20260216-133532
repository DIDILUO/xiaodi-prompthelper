        fs.writeFileSync(filePath, resolved.buffer);
        const targetMeta = sanitizeGeneratedTargetMeta(item?.targetMeta || item);
        let targetMetaFileName = '';
        let targetMetaFilePath = '';
        if (targetMeta) {

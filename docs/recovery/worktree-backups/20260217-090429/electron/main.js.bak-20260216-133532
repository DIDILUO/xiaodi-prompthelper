      const maxFiles = sanitizeGeneratedCacheMaxFiles(payload?.maxFiles);
      const sourceItems = Array.isArray(payload?.items) ? payload.items : [];
      const now = Date.now();
      const savedItems = [];
      for (let index = 0; index < sourceItems.length; index += 1) {

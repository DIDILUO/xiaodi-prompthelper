/* recovery override: floating layers keep 10px side inset */
.floating-layer,
.identity-quick-panel.identity-quick-panel-portal,
.settings-model-dropdown {
  max-width: calc(100vw - 20px) !important;
}

/* lighten floating layer transform pipeline to reduce stutter */
.floating-layer {
  backface-visibility: hidden;
  transform: translateZ(0);
}
